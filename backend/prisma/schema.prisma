// Niffer Cosmetics - Prisma Schema
// SQLite for easy local development → switch to PostgreSQL for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  MPESA
  TIGO
  AIRTEL
  CARD
  OTHER
}

model User {
  id            String    @id @default(uuid())
  phone         String    @unique
  email         String?   @unique
  name          String
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  referralCode  String    @unique
  referredById  String?
  referredBy    User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]    @relation("Referrals")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]
  commissions   Commission[]
  addresses     Address[]
  cartItems     CartItem[]
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String?  // Home, Office...
  fullName    String
  phone       String
  addressLine String
  city        String
  region      String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Category {
  id          String    @id @default(uuid())
  slug        String    @unique
  nameEn      String
  nameSw      String
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id              String      @id @default(uuid())
  slug            String      @unique
  nameEn          String
  nameSw          String
  descriptionEn   String
  descriptionSw   String
  howToUseEn      String?
  howToUseSw      String?
  ingredients     String?
  price           Int         // in TZS (cents not needed, whole shillings)
  compareAtPrice  Int?        // original/strikethrough price
  sku             String?     @unique
  stock           Int         @default(0)
  lowStockThreshold Int       @default(5)
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  images          String      // JSON array of image URLs for simplicity
  badge           String?     // Bestseller, New, Sale...
  rating          Float       @default(0)
  reviewCount     Int         @default(0)
  isActive        Boolean     @default(true)
  isFeatured      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  orderItems      OrderItem[]
  cartItems       CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model Order {
  id                String        @id @default(uuid())
  orderNumber       String        @unique  // e.g. NC-20260828-XXXX
  userId            String?
  user              User?         @relation(fields: [userId], references: [id])
  status            OrderStatus   @default(PENDING)
  
  // Customer snapshot (for guest checkout too)
  customerName      String
  customerPhone     String
  customerEmail     String?
  shippingAddress   String
  shippingCity      String
  shippingRegion    String?
  notes             String?

  subtotal          Int
  shippingFee       Int           @default(0)
  discount          Int           @default(0)
  total             Int
  referralCodeUsed  String?
  
  paymentMethod     PaymentMethod?
  paymentStatus     PaymentStatus @default(PENDING)
  pesapalTrackingId String?
  pesapalMerchantRef String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  paidAt            DateTime?

  items             OrderItem[]
  commissions       Commission[]
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String  // snapshot
  quantity    Int
  unitPrice   Int
  totalPrice  Int
}

model Commission {
  id          String   @id @default(uuid())
  userId      String   // the referrer
  user        User     @relation(fields: [userId], references: [id])
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  amount      Int      // in TZS
  rate        Float    // e.g. 0.10 for 10%
  status      String   @default("PENDING") // PENDING, APPROVED, PAID
  createdAt   DateTime @default(now())
  paidAt      DateTime?
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}
