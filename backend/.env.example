NODE_ENV=development
PORT=4000

# Termux / local SQLite (default):
DATABASE_URL="file:./dev.db"
# Production Postgres example:
# DATABASE_URL="postgresql://user:pass@host:5432/emish?schema=public"
# (also set provider = "postgresql" in prisma/schema.prisma)

JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox
PESAPAL_IPN_URL=
PESAPAL_CALLBACK_URL=
PESAPAL_IPN_ID=

AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=EMISH

APP_URL=http://localhost:3000
API_URL=http://localhost:4000

COMMISSION_RATE=0.10
FREE_SHIPPING_THRESHOLD=50000
SHIPPING_DAR=3000
SHIPPING_UPCOUNTRY=8000
