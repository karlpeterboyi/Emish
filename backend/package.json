{
  "name": "niffer-cosmetics-backend",
  "version": "1.0.0",
  "description": "Niffer Cosmetics - E-commerce API for Tanzania (Skincare & Hair Care)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "npm install && npx prisma generate && npx prisma db push && npm run db:seed"
  },
  "keywords": [
    "ecommerce",
    "tanzania",
    "pesapal",
    "beauty",
    "niffer"
  ],
  "author": "Niffer Cosmetics",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@types/node": "^26.4.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
